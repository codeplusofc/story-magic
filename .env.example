# Configure uma ou mais chaves (plano gratuito). Sem nenhuma, o app usa modo demo.
# O app tenta os provedores nesta ordem: Groq -> Gemini -> OpenRouter.
# Se um modelo estourar o limite (429), ele é pulado por um tempo e o próximo é usado,
# então cada chave/modelo a mais soma cota.

# Supabase Auth (Project Settings -> API)
# Use apenas a chave publicável/anon; nunca use a service_role no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq: https://console.groq.com/keys
VITE_GROQ_API_KEY=
# Opcional — cada modelo do Groq tem cota separada (lista em https://console.groq.com/docs/models).
# VITE_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Google AI Studio: https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=
# Opcional — um ou mais, separados por vírgula. Prefira os "lite" (os maiores gastam tokens pensando).
# VITE_GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# OpenRouter: https://openrouter.ai/keys (modelos gratuitos terminam em ":free")
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
