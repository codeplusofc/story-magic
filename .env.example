# Escolha uma ou duas chaves (tier gratuito). Sem .env, o app usa modo demo.
# Se VITE_GROQ_API_KEY e VITE_GEMINI_API_KEY estiverem definidas, o app usa Groq primeiro
# (útil quando o Gemini retorna 429 por cota / limite de requisições).
# Groq: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=
# Opcional — padrão gemini-2.0-flash (1.5-flash costuma dar 404 no v1beta).
# VITE_GEMINI_MODEL=gemini-2.5-flash
