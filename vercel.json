{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/gutenberg/:path*", "destination": "https://www.gutenberg.org/:path*" },
    { "source": "/gutenberg-mirror/:path*", "destination": "https://aleph.pglaf.org/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
